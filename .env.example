# Database URL - defaults to SQLite in data/dev.db
DATABASE_URL=sqlite://data/dev.db

# Server bind address - where the service listens
BIND_ADDR=0.0.0.0:4563

# Allowed CORS origins - comma-separated URIs (empty = no cross-origin requests)
# IMPORTANT: In production, this must be set explicitly to prevent open CORS
ALLOWED_ORIGINS=

# Logging level - trace, debug, info, warn, error
RUST_LOG=info

# Log output format - pretty (human-readable) or json (structured)
LOG_FORMAT=pretty
